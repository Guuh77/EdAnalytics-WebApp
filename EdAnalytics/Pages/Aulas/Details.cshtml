@page
@model EdAnalytics.Pages.Aulas.DetailsModel
@{
    ViewData["Title"] = Model.Aula?.Titulo ?? "Aula";
}

@if(Model.Aula == null)
{
    <p>Aula não encontrada.</p>
}
else
{
    <div class="mb-4">
        <a asp-page="./Index" asp-route-cursoId="@Model.Aula.CursoId" class="btn btn-secondary mb-3">&larr; Voltar para as aulas</a>
        
        <div class="card p-5 shadow-sm bg-light">
            @Html.Raw(Model.Aula.Conteudo)
        </div>
    </div>
}
