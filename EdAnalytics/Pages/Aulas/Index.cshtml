@page
@model EdAnalytics.Pages.Aulas.IndexModel
@{
    ViewData["Title"] = "Grade de Aulas";
    
    // Calcular progresso do curso em tempo real
    int totalAulas = Model.Aulas.Count;
    int aulasConcluidas = Model.Aulas.Count(a => Model.WatchedAulas.Contains(a.Id));
    int percentualProgresso = totalAulas > 0 ? (int)Math.Round((double)aulasConcluidas / totalAulas * 100) : 0;
}

<div class="container py-5">
    
    <!-- HEADER BAR -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">
        <div>
            <h1 class="aulas-main-title mb-2">Grade Curricular</h1>
            <p class="text-muted mb-0">Assista às aulas completas, acumule horas e garanta sua certificação digital.</p>
        </div>
        <div class="d-inline-flex gap-2">
            <a asp-page="/Cursos/Index" class="btn btn-secondary px-3 py-2 btn-nav">
                &larr; Voltar aos Cursos
            </a>
            <a asp-page="Create" asp-route-cursoId="@Model.CursoId" class="btn btn-primary btn-premium-glow px-4 py-2 btn-nav">
                Nova Aula <i class="bi bi-plus-lg ms-1"></i>
            </a>
        </div>
    </div>

    @if (totalAulas > 0)
    {
        <!-- PROGRESS HEADER CARD -->
        <div class="card glass-card p-4 border-0 mb-5 shadow-lg">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3">
                <h5 class="mb-0 text-white"><i class="bi bi-bar-chart-fill text-wine-highlight me-2"></i>Seu Progresso neste Curso</h5>
                <span class="fw-bold @(percentualProgresso == 100 ? "text-success" : "text-wine-highlight")">
                    @aulasConcluidas de @totalAulas aulas concluídas (@percentualProgresso%)
                </span>
            </div>
            <div class="progress progress-custom">
                <div class="progress-bar progress-bar-wine" role="progressbar" 
                     style="width: @percentualProgresso%" 
                     aria-valuenow="@percentualProgresso" 
                     aria-valuemin="0" 
                     aria-valuemax="100"></div>
            </div>
            @if (percentualProgresso == 100)
            {
                <div class="alert alert-success-custom mt-3 mb-0 py-2.5 px-3 d-flex align-items-center border-0">
                    <i class="bi bi-award-fill text-success fs-5 me-2"></i>
                    <div>
                        <strong>Excelente!</strong> Curso 100% concluído. Acesse os seus <a href="/Aluno/Certificados" class="text-white fw-bold underline text-decoration-underline">Certificados</a> para emitir sua certificação digital.
                    </div>
                </div>
            }
        </div>
    }

    <!-- LECTURES GRID LIST -->
    <div class="d-flex flex-column gap-3">
        @if (totalAulas == 0)
        {
            <div class="text-center py-5">
                <div class="card glass-card p-5 border-0">
                    <i class="bi bi-folder-x text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4>Nenhuma aula encontrada</h4>
                    <p class="text-muted mb-0">Nenhuma aula foi cadastrada para este curso ainda.</p>
                </div>
            </div>
        }
        else
        {
            @for (int idx = 0; idx < Model.Aulas.Count; idx++)
            {
                var aula = Model.Aulas[idx];
                bool isCompleted = Model.WatchedAulas.Contains(aula.Id);
                
                <div class="card glass-card border-0 card-lecture-item">
                    <div class="card-body p-3.5">
                        <div class="row align-items-center">
                            
                            <!-- INDEX / CIRCLE -->
                            <div class="col-auto">
                                <div class="index-circle @(isCompleted ? "completed" : "")">
                                    @if (isCompleted)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }
                                    else
                                    {
                                        <span>@(idx + 1)</span>
                                    }
                                </div>
                            </div>
                            
                            <!-- TITLE -->
                            <div class="col">
                                <h5 class="lecture-title mb-1 text-white">@aula.Titulo</h5>
                                <div class="d-flex gap-3 text-muted small" style="font-size: 0.75rem;">
                                    <span>ID: @aula.Id</span>
                                    <span><i class="bi bi-clock me-1"></i> 2 horas</span>
                                </div>
                            </div>

                            <!-- BADGE STATUS -->
                            <div class="col-sm-auto my-2 my-sm-0 text-start text-sm-end">
                                @if (isCompleted)
                                {
                                    <span class="badge badge-success-custom px-3 py-1.5 fw-bold">
                                        <i class="bi bi-patch-check-fill me-1"></i> Concluída
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-pending-custom px-3 py-1.5 fw-bold">
                                        <i class="bi bi-play-circle me-1"></i> Pendente
                                    </span>
                                }
                            </div>

                            <!-- ACTION BUTTON -->
                            <div class="col-auto text-end">
                                <a asp-page="./Details" asp-route-id="@aula.Id" 
                                   class="btn btn-sm px-4 py-2 btn-lecture-action @(isCompleted ? "btn-outline-secondary text-secondary-custom" : "btn-info-custom")">
                                    @(isCompleted ? "Rever Aula" : "Estudar") <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
    </div>

</div>

<style>
    .aulas-main-title {
        font-weight: 800;
        background: linear-gradient(135deg, #ffffff, #ffb6c7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
    }
    .glass-card {
        background: rgba(26, 18, 21, 0.6);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4) !important;
    }

    /* Course Progress bar */
    .progress-custom {
        height: 10px;
        background-color: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        overflow: hidden;
    }
    .progress-bar-wine {
        background: linear-gradient(90deg, #8e1b34, #ff5c7d);
        border-radius: 10px;
    }
    .text-wine-highlight {
        color: #ffb6c7;
    }
    .alert-success-custom {
        background-color: rgba(40, 167, 69, 0.1);
        border: 1px solid rgba(40, 167, 69, 0.2) !important;
        border-radius: 10px;
        color: #ffb6c7;
        font-size: 0.85rem;
    }

    /* Lecture list item */
    .card-lecture-item {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    .card-lecture-item:hover {
        background: rgba(26, 18, 21, 0.85);
        transform: translateY(-2px);
        border-color: rgba(142, 27, 52, 0.35) !important;
        box-shadow: 0 4px 15px rgba(142, 27, 52, 0.15) !important;
    }
    
    /* Index circle */
    .index-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.5);
    }
    .index-circle.completed {
        background-color: rgba(40, 167, 69, 0.15);
        border-color: rgba(40, 167, 69, 0.4);
        color: #28a745;
    }

    .lecture-title {
        font-weight: 700;
        font-size: 1.05rem;
    }

    /* Badges */
    .badge-success-custom {
        background-color: rgba(40, 167, 69, 0.12);
        color: #28a745;
        border: 1px solid rgba(40, 167, 69, 0.25);
        border-radius: 12px;
        font-size: 0.775rem;
    }
    .badge-pending-custom {
        background-color: rgba(142, 27, 52, 0.15);
        color: #ffb6c7;
        border: 1px solid rgba(184, 33, 66, 0.25);
        border-radius: 12px;
        font-size: 0.775rem;
    }

    /* Button Lecture Actions */
    .btn-lecture-action {
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
    }
    .btn-lecture-action:hover {
        transform: translateY(-1px);
    }
    .btn-info-custom {
        background-color: #2b171e;
        color: #ffb6c7;
        border: 1px solid #8e1b34;
    }
    .btn-info-custom:hover {
        background-color: #8e1b34;
        color: white;
        border-color: #b82142;
    }
    .text-secondary-custom {
        color: #a4969c !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
    }
    .text-secondary-custom:hover {
        background-color: rgba(255,255,255,0.03);
        color: white !important;
    }

    .btn-nav {
        font-size: 0.9rem;
        font-weight: 600;
    }
    .btn-premium-glow {
        background: linear-gradient(135deg, #8e1b34, #630c20) !important;
        border: none !important;
        box-shadow: 0 4px 15px rgba(142, 27, 52, 0.4) !important;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
        font-weight: 600;
    }
    .btn-premium-glow:hover {
        background: linear-gradient(135deg, #b82142, #8e1b34) !important;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(184, 33, 66, 0.5) !important;
    }
</style>
