@page
@model EdAnalytics.Pages.Aluno.PerfilModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<div class="container py-5">
    <!-- HERO USER SECTION -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card glass-card p-4 border-0 text-md-start text-center">
                <div class="row align-items-center">
                    <div class="col-md-auto mb-3 mb-md-0">
                        <div class="profile-avatar-container mx-auto">
                            <span class="avatar-initial">@Model.Name[0].ToString().ToUpper()</span>
                            <div class="avatar-glow"></div>
                        </div>
                    </div>
                    <div class="col-md">
                        <span class="badge badge-wine-role px-3 py-1.5 mb-2">@Model.Role Premium</span>
                        <h1 class="user-fullname mb-1">@Model.Name</h1>
                        <p class="user-email text-muted mb-0"><i class="bi bi-envelope-fill me-2"></i>@Model.Email</p>
                    </div>
                    <div class="col-md-auto mt-3 mt-md-0">
                        <a asp-page="/Aluno/Certificados" class="btn btn-primary btn-premium-glow px-4 py-2">
                            Ver Certificados <i class="bi bi-patch-check-fill ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- STATS COUNTERS & PROGRESS -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card glass-card p-4 border-0 text-center text-md-start h-100 card-stat">
                <div class="d-flex align-items-center justify-content-center justify-content-md-start mb-3">
                    <div class="icon-circle me-3"><i class="bi bi-clock-history"></i></div>
                    <h5 class="mb-0 text-secondary">Tempo de Estudo</h5>
                </div>
                <div class="d-flex align-items-baseline justify-content-center justify-content-md-start">
                    <span class="stat-value text-white">@Model.TotalStudyHours</span>
                    <span class="stat-unit text-muted ms-1">horas assistidas</span>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card glass-card p-4 border-0 text-center text-md-start h-100 card-stat">
                <div class="d-flex align-items-center justify-content-center justify-content-md-start mb-3">
                    <div class="icon-circle me-3"><i class="bi bi-journal-bookmark-fill"></i></div>
                    <h5 class="mb-0 text-secondary">Cursos Concluídos</h5>
                </div>
                <div class="d-flex align-items-baseline justify-content-center justify-content-md-start">
                    <span class="stat-value text-white">@Model.CompletedCoursesCount</span>
                    <span class="stat-unit text-muted ms-1">módulos completos</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card glass-card p-4 border-0 text-center text-md-start h-100 card-stat">
                <div class="d-flex align-items-center justify-content-center justify-content-md-start mb-3">
                    <div class="icon-circle me-3"><i class="bi bi-award-fill"></i></div>
                    <h5 class="mb-0 text-secondary">Certificados Emitidos</h5>
                </div>
                <div class="d-flex align-items-baseline justify-content-center justify-content-md-start">
                    <span class="stat-value text-white">@Model.TotalCertificatesEarned</span>
                    <span class="stat-unit text-muted ms-1">certificados</span>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN INTERACTIVE SECTION -->
    <div class="row g-5">
        <!-- RECENT ACTIVITIES & COURSE PROGRESS -->
        <div class="col-lg-6">
            <h3 class="section-title mb-4">Progresso de Estudos</h3>
            <div class="card glass-card p-4 border-0">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 text-white">Cursos Matriculados</h5>
                    <span class="text-wine-highlight fw-bold">@Model.CompletionRatePercentage% Total</span>
                </div>

                <div class="d-flex flex-column gap-4">
                    @if (!Model.RecentActivities.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-journal-x fs-1 mb-2 text-secondary d-block"></i>
                            <h5 class="text-secondary mb-1">Você ainda não iniciou nenhum curso</h5>
                            <p class="small text-muted mb-3" style="font-size: 0.8rem;">Dê o primeiro passo na sua jornada acadêmica acessando nosso catálogo!</p>
                            <a href="/Cursos" class="btn btn-sm btn-primary btn-premium-glow px-4 py-2">Explorar Catálogo</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var activity in Model.RecentActivities)
                        {
                            <div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="course-name-progress text-light">@activity.CourseName</span>
                                    <span class="course-percent-progress fw-bold @(activity.ProgressPercentage == 100 ? "text-success" : "text-wine-highlight")">
                                        @activity.ProgressPercentage%
                                    </span>
                                </div>
                                <div class="progress progress-custom">
                                    <div class="progress-bar progress-bar-wine" role="progressbar" 
                                         style="width: @activity.ProgressPercentage%" 
                                         aria-valuenow="@activity.ProgressPercentage" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100"></div>
                                </div>
                                <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Último acesso: @activity.LastAccess</small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- LEARNING CHART MOCKUP -->
        <div class="col-lg-6">
            <h3 class="section-title mb-4">Atividade Semanal</h3>
            <div class="card glass-card p-4 border-0 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 text-white">Tempo por dia</h5>
                    <small class="text-muted">Últimos 7 dias</small>
                </div>
                
                <!-- SVG GRAPHIC DESIGN -->
                <div class="chart-container text-center py-3">
                    <svg viewBox="0 0 400 200" class="w-100" style="max-height: 180px;">
                        <!-- Grid lines -->
                        <line x1="40" y1="30" x2="380" y2="30" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
                        <line x1="40" y1="80" x2="380" y2="80" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
                        <line x1="40" y1="130" x2="380" y2="130" stroke="rgba(255,255,255,0.05)" stroke-width="1" />
                        <line x1="40" y1="170" x2="380" y2="170" stroke="rgba(255,255,255,0.15)" stroke-width="1" />
                        
                        <!-- Gradient definitions -->
                        <defs>
                            <linearGradient id="chartGlow" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="var(--wine-hover)" stop-opacity="0.4" />
                                <stop offset="100%" stop-color="var(--wine-base)" stop-opacity="0.0" />
                            </linearGradient>
                        </defs>
                        
                        <!-- Filled Area -->
                        <path d="M 40 170 L 40 130 L 90 90 L 140 140 L 195 50 L 250 80 L 310 40 L 365 110 L 365 170 Z" fill="url(#chartGlow)" />
                        
                        <!-- Main Line -->
                        <path d="M 40 130 Q 90 90 140 140 T 195 50 T 250 80 T 310 40 T 365 110" fill="none" stroke="#b82142" stroke-width="3" />
                        
                        <!-- Dots -->
                        <circle cx="40" cy="130" r="4" fill="#fff" stroke="#8e1b34" stroke-width="2" />
                        <circle cx="90" cy="90" r="4" fill="#fff" stroke="#8e1b34" stroke-width="2" />
                        <circle cx="140" cy="140" r="4" fill="#fff" stroke="#8e1b34" stroke-width="2" />
                        <circle cx="195" cy="50" r="4" fill="#fff" stroke="#8e1b34" stroke-width="2" />
                        <circle cx="250" cy="80" r="4" fill="#fff" stroke="#8e1b34" stroke-width="2" />
                        <circle cx="310" cy="40" r="4" fill="#fff" stroke="#8e1b34" stroke-width="2" />
                        <circle cx="365" cy="110" r="4" fill="#fff" stroke="#8e1b34" stroke-width="2" />
                        
                        <!-- Labels -->
                        <text x="40" y="190" fill="rgba(255,255,255,0.4)" font-size="10" text-anchor="middle">Seg</text>
                        <text x="90" y="190" fill="rgba(255,255,255,0.4)" font-size="10" text-anchor="middle">Ter</text>
                        <text x="140" y="190" fill="rgba(255,255,255,0.4)" font-size="10" text-anchor="middle">Qua</text>
                        <text x="195" y="190" fill="rgba(255,255,255,0.4)" font-size="10" text-anchor="middle">Qui</text>
                        <text x="250" y="190" fill="rgba(255,255,255,0.4)" font-size="10" text-anchor="middle">Sex</text>
                        <text x="310" y="190" fill="rgba(255,255,255,0.4)" font-size="10" text-anchor="middle">Sab</text>
                        <text x="365" y="190" fill="rgba(255,255,255,0.4)" font-size="10" text-anchor="middle">Dom</text>
                    </svg>
                </div>
                
                <div class="alert alert-tips-custom mt-3 text-start">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Dica Premium:</strong> Seu horário de estudo mais produtivo foi às <strong>Quinta-feiras às 14h</strong>. Continue assim!
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(26, 18, 21, 0.6);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4) !important;
    }
    .profile-avatar-container {
        position: relative;
        width: 90px;
        height: 90px;
        background: linear-gradient(135deg, #8e1b34, #2b080f);
        border: 2px solid rgba(255,255,255,0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .avatar-initial {
        font-size: 2.8rem;
        font-weight: 800;
        color: white;
        text-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }
    .avatar-glow {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        border-radius: 50%;
        box-shadow: 0 0 25px rgba(184, 33, 66, 0.4);
        pointer-events: none;
    }
    .badge-wine-role {
        background-color: rgba(142, 27, 52, 0.3);
        border: 1px solid rgba(184, 33, 66, 0.4);
        color: #ffb6c7;
        font-size: 0.85rem;
    }
    .user-fullname {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #ffffff, #ffb6c7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .user-email {
        font-size: 0.95rem;
    }
    
    /* Stats */
    .card-stat {
        transition: all 0.3s ease;
    }
    .card-stat:hover {
        transform: translateY(-5px);
        border-color: rgba(142, 27, 52, 0.3) !important;
    }
    .icon-circle {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background-color: rgba(142, 27, 52, 0.2);
        border: 1px solid rgba(184, 33, 66, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffb6c7;
        font-size: 1.25rem;
    }
    .stat-value {
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -1px;
    }
    .stat-unit {
        font-size: 0.9rem;
    }

    .section-title {
        font-size: 1.4rem;
        font-weight: 800;
        border-left: 4px solid #8e1b34;
        padding-left: 12px;
    }

    /* Progress bars */
    .course-name-progress {
        font-size: 0.925rem;
        font-weight: 600;
    }
    .course-percent-progress {
        font-size: 0.9rem;
    }
    .progress-custom {
        height: 8px;
        background-color: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
        overflow: hidden;
    }
    .progress-bar-wine {
        background: linear-gradient(90deg, #8e1b34, #ff5c7d);
        border-radius: 10px;
    }
    .text-wine-highlight {
        color: #ffb6c7;
    }

    /* Info tips alert */
    .alert-tips-custom {
        background-color: rgba(142, 27, 52, 0.12);
        color: #ffb6c7;
        border: 1px solid rgba(142, 27, 52, 0.25);
        border-radius: 10px;
        font-size: 0.85rem;
    }
</style>
