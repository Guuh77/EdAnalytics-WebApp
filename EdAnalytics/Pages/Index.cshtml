@page
@model EdAnalytics.Pages.IndexModel
@{
    ViewData["Title"] = "Início";
}

<div class="text-center mt-5 mb-5">
    <h1 class="display-3 mb-4 rounded px-3 py-2 bg-dark d-inline-block shadow-sm">Bem-vindo à EdAnalytics</h1>
    
    <div class="card p-5 mt-4 mx-auto border-0 shadow-lg" style="max-width: 800px; background: linear-gradient(145deg, var(--bg-surface), #26171d);">
        <h3 class="mb-4" style="color: var(--wine-hover);">O que é a nossa plataforma?</h3>
        
        <p class="fs-5" style="line-height: 1.8; color: var(--text-secondary);">
            A <strong>EdAnalytics Premium</strong> é um ecossistema educacional construído para fornecer métricas profundas e 
            análises de comportamento em ambientes de Ensino a Distância. Aliamos um catálogo extenso de cursos 
            à tecnologia de alto desempenho para criar a melhor experiência de leitura e observabilidade.
        </p>

        <p class="fs-5 mt-3" style="line-height: 1.8; color: var(--text-secondary);">
            Explore dezenas de aulas completas, aprenda sobre arquitetura de dados e entenda perfeitamente 
            quais são os dilemas do torcedor corinthiano ao vivo.
        </p>

        <div class="mt-5">
            <a asp-page="/Cursos/Index" class="btn btn-primary btn-lg px-5 py-3 shadow-sm" style="font-size: 1.2rem;">
                Acessar Catálogo de Cursos &rarr;
            </a>
        </div>
    </div>
</div>
